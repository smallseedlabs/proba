# PLACEHOLDER FILE. Copy to an untracked operator.env (mode 600). Never commit real values.
# Every ${NAME:?…} in deploy/stacks/*.yml must be set in the deploying shell.
# Repositories are public: customer and private deployment config does not belong in git.

# Image placeholders. There is no GHCR publish workflow on sibling mains (CI push: false).
# Build from the SHAs in deploy/IMAGE_PROVENANCE.md and retag before a real rollout.
REGISTRY=ghcr.io/smallseedlabs
VERSION=latest

# Host directory of chmod 600 private PEMs (uid 1001) on nodes labeled proba.keys=true.
# Docker secrets are 0444 and Hub/Gateway refuse group/other-readable private keys.
PROBA_KEYS_DIR=/etc/proba/keys

# URL-safe hex; must match docker secret postgres_password / the DATABASE_URL password.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
REDIS_USER=proba
CLICKHOUSE_PASSWORD=
CLICKHOUSE_CONSUMER_PASSWORD=
CLICKHOUSE_API_PASSWORD=
CLICKHOUSE_MIGRATOR_PASSWORD=
ANCHOR_HMAC_KEY=
ANCHOR_DB_PASSWORD=
CONTEXT_POSTGRES_PASSWORD=
MEMORY_POSTGRES_PASSWORD=

# Browser origin of the Hub (HTTPS via operator TLS proxy). No default host.
# Do not set this to smallseedlabs.com as a fallback.
PUBLIC_HUB_URL=
CORS_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Optional Insights / audit browser URL. Empty keeps CORS off on audit-api.
PUBLIC_AUDIT_API_URL=
PUBLIC_PORTAL_ORIGIN=
PUBLIC_MEMORY_API_URL=
AUDIT_API_ADMIN_EMAILS=
MEMORY_API_ADMIN_EMAILS=

# Hub production default is mock brain. Hub main has no GATEWAY_URL.
# AUDIT_CONTENT_ENABLED production default is false.
AUDIT_CONTENT_ENABLED=false
LOG_LEVEL=info

# Optional memory stack: production refuses hash/scripted. Leave unset if you do not deploy 40-memory.yml.
# MEMORY_EMBEDDER=openai-compatible
# MEMORY_EMBEDDER_BASE_URL=
# MEMORY_EMBEDDER_MODEL=
# MEMORY_EMBEDDER_API_KEY=
# MEMORY_LLM_PROVIDER=deepseek
# MEMORY_LLM_BASE_URL=https://api.deepseek.com
# MEMORY_LLM_MODEL=
# MEMORY_LLM_API_KEY=

# Optional llm stack (paid provider). Do not set from CI. No live requests in this repo.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=
# LLM_ALLOWED_HOSTS=api.deepseek.com
# LLM_ALLOWED_MODELS=

# Optional gateway: ADS_DOMAIN_URL empty = ads verbs fail closed. RESEARCH_HTTP_FETCH is false in the stack.
# GATEWAY_LLM_KEY_ID=gateway-llm-1
# ADS_DOMAIN_URL=

# Campaign destination URLs are request arguments on Ads. There is no env default.
