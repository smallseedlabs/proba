# Proba local platform: copy to local/.env (up.sh does it for you). local/.env is gitignored.
# Never commit real values. Everything here is for localhost only.

# --- Secrets: leave empty. up.sh generates random local-only values on first run. ---
JWT_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# Bearer token for the audit-api's local `static` token verifier (never used in production).
AUDIT_API_LOCAL_TOKEN=
# A second static token, for a viewer (local-viewer@proba.local): lets verify.sh prove that viewers never get raw text.
# Only the audit API's `static` verifier knows it; the portal signs in with Firebase and never uses it.
AUDIT_API_LOCAL_VIEWER_TOKEN=

# --- Firebase sign-in for the web app and the Hub -------------------------------------
# These identify your Firebase project to the browser (Firebase console > Project settings >
# General > Your apps > Web app). They are public identifiers, not secrets, but keep them
# here and out of the repository. Leave empty to run without browser sign-in: seed.sh and
# verify.sh then use the Hub's development login (see docs/LOCAL_TESTING.md).
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Optional allow-list of email domains that may sign in (comma separated, verified emails only). Empty = anyone.
AUTH_ALLOWED_EMAIL_DOMAINS=

# --- Hub development login (POST /dev/login, password-less, never in production) --------
# true: seed.sh/verify.sh can create a session without Firebase. false: set HUB_SESSION_TOKEN
# (a session token you got by signing in with Firebase in the browser) for seed.sh/verify.sh.
DEV_LOGIN_ENABLED=true
HUB_SESSION_TOKEN=

# --- Host ports (all bound to 127.0.0.1). up.sh refuses to start if one is taken. ----------
WEB_HOST_PORT=5180
HUB_HOST_PORT=3300
POSTGRES_HOST_PORT=55433
REDIS_HOST_PORT=56380
CLICKHOUSE_HTTP_HOST_PORT=58125
AUDIT_CONSUMER_HOST_PORT=3401
METRICS_INGESTER_HOST_PORT=3402
ROLLUP_HOST_PORT=3403
AUDIT_API_HOST_PORT=3400
# Only with the portal profile (./up.sh --portal)
PORTAL_HOST_PORT=3410
# Optional: address of the memory console; when set the portal shows a Memory entry (empty: none)
PORTAL_MEMORY_URL=

# --- Where the images are built from -------------------------------------------------------
# main (default): up.sh snapshots the committed `main` of each sibling checkout into local/.src/
#   with `git archive`, so uncommitted work or another branch in your checkouts never leaks in.
# worktree: build from the sibling working trees exactly as they are on disk.
PROBA_SRC=main
# Ref to snapshot in main mode (a branch or tag that exists in each sibling checkout).
PROBA_REF=origin/main
# Sibling checkouts, relative to this directory or absolute.
PROBA_HUB_DIR=../../proba-hub
PROBA_WEB_DIR=../../proba-web
PROBA_AUDIT_DIR=../../proba-audit
PROBA_PORTAL_DIR=../../proba-portal

# --- audit-api sign-in ------------------------------------------------------------------
# static (default): bearer token AUDIT_API_LOCAL_TOKEN, an admin. firebase: Firebase ID tokens of
# FIREBASE_PROJECT_ID; then list who may read in AUDIT_API_ADMIN_EMAILS / AUDIT_API_ALLOWED_EMAILS /
# AUDIT_API_ALLOWED_EMAIL_DOMAINS (verified emails; an empty policy allows nobody).
AUDIT_API_TOKEN_VERIFIER=static
AUDIT_API_ADMIN_EMAILS=local-admin@proba.local
# Viewers (read everything except raw text). Empty: only local-viewer@proba.local, the static viewer token above.
AUDIT_API_ALLOWED_EMAILS=
AUDIT_API_ALLOWED_EMAIL_DOMAINS=

# --- Raw text of events (protocol 0.3.3 `content`) ---------------------------------------------
# On by default locally, so the portal's Content panel and verify.sh's raw-text checks have something to show.
# One flag for the Hub (writes the text, secrets masked), the audit-consumer (stores it apart from the hash chain,
# table audit_event_content, migration 0008 that up.sh applies before the consumer starts) and the audit-api (serves
# it to administrators only, every read audited). Set false to run as production does by default (text is never stored).
AUDIT_CONTENT_ENABLED=true
AUDIT_CONTENT_STORE=clickhouse

# --- Stub metrics data (the development data source of proba-audit) -----------------------
PLATFORM_CONNECTORS=meta:stub,google:stub
# The stub revises recent hours this often, so a short run shows restatements.
STUB_RESTATE_EVERY_MINUTES=1
INGEST_INTERVAL_MS=10000
ROLLUP_INTERVAL_MS=5000

# --- Hub brain scenario (the Hub's scripted MockBrain; there is no LLM) --------------------
MOCK_BRAIN_SCENARIO=happy_path
LOG_LEVEL=info
